generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ── ENUM ─────────────────────────────

enum UserRole {
  GENERAL_ADMIN
  SERVICE_ADMIN
  SUPER_ADMIN
  SYSTEM
}

enum TicketStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  RETURNED
  CLOSED
}

enum NotificationType {
  SUBMITTED
  RETURNED
  RESOLVED
}

enum TicketCategory {
  KRITIK
  SARAN
  KOMENTAR
}

enum Sentiment {
  POSITIF
  NETRAL
  NEGATIF
}

enum AuditLogType {
  STATUS_CHANGED
  ASSIGNED
  REASSIGNED
  RATING_GIVEN
}

// ── MODELS ───────────────────────────

model User {
  id       String   @id @default(uuid())
  name     String?
  email    String?  @unique
  username String?   @unique
  password String?
  role     UserRole
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedServices Service[]             @relation("ServiceAdmin")
  assignedTickets  Ticket[]              @relation("AssignedTickets")
  actorAuditLogs   TicketAuditLog[]
}

model Service {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  icon        String?
  color       String?
  bgColor     String?
  isActive    Boolean @default(true)

  requiresManualAssignment Boolean @default(false)

  assignedAdminId String?
  assignedAdmin   User? @relation("ServiceAdmin", fields: [assignedAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model Ticket {
  id           String @id @default(uuid())
  ticketNumber String @unique

  name    String?
  email   String
  subject String?
  message String

  status TicketStatus @default(SUBMITTED)

  sentiment Sentiment?
  category  TicketCategory?
  aiSource  String? @default("rule-based")

  rejectionReason String?

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  assignedToId String?
  assignedTo   User? @relation("AssignedTickets", fields: [assignedToId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  notifications   NotificationLog[]
  rating          Rating?
  ticketAuditLogs TicketAuditLog[]
  attachments     Attachment[]
}

model TicketStatusHistory {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  status TicketStatus

  changedById String?
  changedBy   User? @relation(fields: [changedById], references: [id])

  createdAt DateTime @default(now())
}

model NotificationLog {
  id String @id @default(uuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  email String
  type  NotificationType

  subject String
  status  String

  sentAt       DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
}

model Rating {
  id       String @id @default(uuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  score   Int
  comment String?

  createdAt DateTime @default(now())
}

model TicketAuditLog {
  id        String       @id @default(cuid())
  
  ticketId  String
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  type      AuditLogType // Menggunakan Enum agar konsisten

  actorId   String?      // Siapa yang melakukan perubahan (Bisa Admin/Sistem)
  actor     User?        @relation(fields: [actorId], references: [id])

  fromValue String?      // Nilai sebelum diubah (misal: "SUBMITTED")
  toValue   String?      // Nilai setelah diubah (misal: "IN_PROGRESS")

  metadata  Json?        // Simpan detail ekstra di sini jika dibutuhkan

  createdAt DateTime     @default(now())

  // Index agar pencarian log berdasarkan tiket atau aktor sangat cepat
  @@index([ticketId])
  @@index([type])
  @@index([actorId])
}

model Attachment {
  id        String   @id @default(cuid())
  ticketId  String
  url       String
  key       String   // path di R2
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}